CTRADER_CLIENT_ID=35414_BEG7mNMrvayxs8P4C0meWzZS1RneqbPalkjO1gIUdwHCelIaLX
CTRADER_CLIENT_SECRET=uAFgCdDOPwswB6sQ8z7fVLfYzzImy9iDYwTXPeOkJtMQzqNzy4
