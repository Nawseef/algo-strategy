# ─── CFD Paper Trading (app.main_ctrader / app.main_cfd_paper) ───────
# Live-paper the 2 backtest-validated USDJPY ORB slices on the cTrader demo
# account. Both are registered strategy ids (app/cfd_strategy/strategies/usdjpy_orb.py):
#   orb_usdjpy_tokyo_5m   — Tokyo open, 5m range, ADX<22 filter, fixed 2R
#   orb_usdjpy_london_15m — London open, 15m range, ADX<22 filter, fixed 2R
# Comma-separated strategy ids to run. Set to "none" to disable trading
# (candle-archiver only mode).
CFD_PAPER_STRATEGIES=orb_usdjpy_tokyo_5m,orb_usdjpy_london_15m
# Starting virtual balance (USD) for the PAPER stream ONLY. Paper is simulated —
# it has no real account to read, so it needs a fixed number. The DEMO (and any
# LIVE) stream IGNORES this and auto-reads its REAL balance from cTrader on
# connect, so its 0.5% is always 0.5% of the actual account (your ~$8k demo).
CFD_PAPER_BALANCE=10000
# Risk per trade (%). Matches the research parameter these slices were tested at.
CFD_PAPER_RISK_PCT=0.5
# Cost model for the PAPER fills: intraday | conservative | zero | raw.
# raw = truly no cost (spread, commission, slippage, swap all zero) — the paper
# fills show the strategy's pure price-action PnL with nothing deducted. This is
# the idealised baseline we compare the real cTrader demo fills against.
CFD_PAPER_COST_MODEL=raw

# ─── Trading streams: paper | demo | live (multi-account) ────────────
# TWO ways to configure which accounts trade (each fed the same signals, each
# with its own alerts + PAPER/DEMO/LIVE label):
#
# 1) PREFERRED for multiple accounts / prop firms — a JSON file. Copy
#    data/cfd_streams.example.json to data/cfd_streams.json and edit it (it is
#    then auto-loaded, and these CFD_PAPER_EXECUTION_MODE vars are ignored). Each
#    stream can be toggled on/off and given its own Telegram channel.
#
# 2) The simple env fallback below (used when no data/cfd_streams.json exists):
#    both = run the PAPER simulation AND the real cTrader DEMO account on the
#    SAME signals, as two separate accounts with separate alerts, to measure the
#    real slippage / spread / commission (demo, read from cTrader's close deal)
#    against the idealised fill (paper).
CFD_PAPER_EXECUTION_MODE=both
# Account labels shown in Telegram + cfd_paper_trades (must be distinct).
CFD_PAPER_ACCOUNT_ID=cfd_paper
CFD_DEMO_ACCOUNT_ID=cfd_ctrader_demo
# Fallback cost model for the DEMO stream ONLY if the real close-deal fetch fails
# (normally the real commission/swap are read straight from cTrader). 'zero' =
# commission-only (real fills already contain spread/slippage).
CFD_DEMO_COST_MODEL=zero
# Periodic portfolio summary cadence to Telegram (minutes); 0 disables. Fired on
# the ROUND wall-clock boundary (e.g. top of each UTC hour for 60), not N min
# after boot.
CFD_PAPER_SUMMARY_MIN=60
# Display name for the engine in start/stop/summary alerts (generic — it runs
# paper + demo + any live firms). Pick your own.
CFD_ENGINE_NAME=SENTINEL
# Archive 5m candles while this runs (true) and write them to the REAL
# live_candles table (false) rather than the comparison staging table — this
# run is genuine paper trading, not a feed-comparison soak test.
CFD_PAPER_ARCHIVE_CANDLES=true
CFD_CTRADER_STAGING=false
