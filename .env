CTRADER_ACCESS_TOKEN=s-j_bFeYOzani-2ifE0bb0pKkuEifYR8gvLd-nflh4g
CTRADER_REFRESH_TOKEN=Kzw6QGwAYyjx5HHGikK7KFi_8zd28RcVzhfgFvQMpgc
CTRADER_TOKEN_EXPIRES_AT=1788981401
# Your cTrader trader login number (shown in cTrader platform, e.g. 52946528)
CTRADER_ACCOUNT_LOGIN=10094824
