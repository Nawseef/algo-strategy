# ─── Groww API Credentials ────────────────────────────────────
# Choose one authentication method:

# Method 1: API Key + Secret (requires daily approval on Groww Cloud API Keys page)
GROWW_API_KEY=your_api_key_here
GROWW_API_SECRET=your_api_secret_here

# Method 2: TOTP Flow (no expiry, recommendebut u said api ked)
GROWW_TOTP_TOKEN=eyJraWQiOiJaTUtjVXciLCJhbGciOiJFUzI1NiJ9.._KPzxl_4V9JtpXULwGWKmDQT7vTfA3Tm1hd0CyKLrB0C3em26sl-BEZU3pUHATxeJlBa8GHCcYP6g6T4Vam_fg
GROWW_TOTP_SECRET=QM4O6TASBTFOLOTMPIP6VI7LAYLYR4X5

# Authentication method: "api_key" or "totp"
GROWW_AUTH_METHOD=totp

# ─── Instruments ─────────────────────────────────────────────
# Comma-separated exchange tokens from:
# https://growwapi-assets.groww.in/instruments/instrument.csv
#
# Stocks: use numeric tokens (2885=Reliance, 11536=TCS, 1333=HDFC Bank)
# Indices: use names (NIFTY, BANKNIFTY, FINNIFTY)
# System auto-detects and routes correctly.
SUBSCRIBE_INSTRUMENTS=NIFTY,BANKNIFTY,2885,1333,4963,3045,5900,317,5258,11536,1594,3499,11723,1363,3063,2031,10999,10604,11483,383,2303,3426

# ─── Candle & Strategy ───────────────────────────────────────
# Timeframes to build candles (comma-separated: 1m,5m,15m,30m,1h,1d)
CANDLE_TIMEFRAMES=1m,5m

# SMA Crossover strategy parameters
SMA_FAST_PERIOD=5
SMA_SLOW_PERIOD=20

# ─── Paper Trading ───────────────────────────────────────────
# Quantity per trade (fallback if position sizing can't calculate)
PAPER_QUANTITY=1

# Starting virtual balance
PAPER_STARTING_BALANCE=100000

# Max simultaneous open positions (0 = unlimited)
PAPER_MAX_POSITIONS=5

# Position sizing: % of balance to allocate per trade
# 10 = invest 10% of balance per trade (Rs.10,000 with Rs.1,00,000 balance)
PAPER_POSITION_SIZE_PCT=10

# ─── Reconnection ────────────────────────────────────────────
# Max reconnection attempts (0 = unlimited, keeps retrying)
RECONNECT_MAX_RETRIES=0

# ─── Historical Data Warmup ──────────────────────────────────
# Enable/disable warmup on startup (true/false)
WARMUP_ENABLED=true
# Max concurrent API requests during warmup
# Set to 1 — warmup now runs sequentially to avoid Groww rate limits at 09:00
# (both research and paper fire simultaneously against the same account)
WARMUP_CONCURRENCY=1
# Delay between requests in milliseconds (rate limit protection)
# 400ms sequential = ~13s for research (24 req) + ~3s for paper (8 req)
# Enough spread so both services don't hammer the same Groww account at 09:00
WARMUP_DELAY_MS=400
# Max retries per failed request
WARMUP_MAX_RETRIES=3
# Base backoff in seconds for retries (doubles each attempt)
WARMUP_RETRY_BACKOFF=1.0

# ─── Telegram Alerts (REQUIRED) ───────────────────────────────
# Get a bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=8909449825:AAGDtDp-sUjj0YftVo2gWAvp1TOXjRKS6EI
# Get your chat ID from @userinfobot or @getidsbot
TELEGRAM_CHAT_ID=1655289022,2064450511,656913280
# Portfolio summary interval in minutes (sent even if no trades happen)
TELEGRAM_SUMMARY_INTERVAL=30
# Control which events trigger notifications (true/false)
TELEGRAM_NOTIFY_SIGNALS=false
TELEGRAM_NOTIFY_POSITIONS=true
TELEGRAM_NOTIFY_RECONNECTS=true
TELEGRAM_NOTIFY_ERRORS=true

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Research Engine (150K Variant System) ────────────────────
# PostgreSQL connection (production VM)
DATABASE_URL=postgresql://algo:algo_research_2026@localhost:5432/research_db

# Research instruments (exchange tokens for variant evaluation)
RESEARCH_INSTRUMENTS=NIFTY,BANKNIFTY,2885,1333,4963,3045,5900,1594,11536,10604

# Max armed variants per instrument (500K = effectively unlimited for backtest)
RESEARCH_MAX_ARMED=500000

# Trade flush interval (seconds)
RESEARCH_FLUSH_INTERVAL=5.0

# Warmup for research engine
RESEARCH_WARMUP_ENABLED=true

# Research log level
RESEARCH_LOG_LEVEL=INFO

# ─── MT5 CFD Feed Consumer (ARM VM) ──────────────────────────
# Reaches the mt5linux RPyC server on the x86 feed VM via SSH tunnel.
# Tunnel:  ssh -i <key> -N -L 8001:localhost:8001 ubuntu@144.24.154.233
MT5_HOST=localhost
MT5_PORT=8001
# The 10 IC Markets CFD symbols (exact broker names).
MT5_SYMBOLS=XAUUSD,XAGUSD,EURUSD,GBPUSD,USDJPY,US30,US500,USTEC,DE40,XTIUSD
# Batched pull cadence per symbol (seconds). 1s keeps the 1 GB feed VM safe.
MT5_POLL_INTERVAL_S=1.0
# Overlap window for gapless pulls (seconds); ticks de-duped by time_msc.
MT5_LOOKBACK_S=10.0
# Broker server-time offset from UTC (hours). Tick time_msc is in SERVER time
# (IC Markets = GMT+3 summer / GMT+2 winter) and copy_ticks_range bounds must
# be in server time too. LEAVE UNSET to auto-detect from the live tick on
# connect (handles DST). Set a number only to force a fixed offset.
# MT5_SERVER_UTC_OFFSET_HOURS=
# Reconnect backoff bounds (seconds).
MT5_RECONNECT_BACKOFF_S=2.0
MT5_RECONNECT_BACKOFF_MAX_S=60.0
# Backfill: replay ticks missed during consumer downtime from feed history
# (only runs with a live-measured offset; capped, chunked, throttled).
MT5_BACKFILL_ENABLED=true
MT5_BACKFILL_MAX_DAYS=3.0
MT5_BACKFILL_CHUNK_S=1800
MT5_BACKFILL_CHUNK_PAUSE_S=0.15
# How often to re-measure the server offset while running (DST / weekend->open).
MT5_OFFSET_REDETECT_S=300

# ─── Forex / CFD Trading Sessions (MT5 consumer) ─────────────
# FX sessions allowed for new entries (comma list: sydney,tokyo,london,new_york).
# The ported "morning" mean-reversion maps to London open (~08:00 UTC winter,
# 07:00 UTC summer) or New York open. Adjust once the strategy is chosen.
FX_TRADING_SESSIONS=london,new_york
# Stop opening / flatten positions this many minutes before the Friday weekly
# close (CFDs carry weekend-gap + swap risk).
FX_FLATTEN_BEFORE_WEEKEND_MIN=60
# Daily drawdown-reset time (firm-agnostic defaults = 17:00 America/New_York,
# the common 5pm ET roll). Override per prop firm once chosen. Used by the
# future execution flatten-guard; ignored while there's no order execution.
FX_DAILY_RESET_HOUR=17
FX_DAILY_RESET_TZ=America/New_York
FX_FLATTEN_BEFORE_RESET_MIN=5

# ─── CFD Telegram (DEDICATED — never mixed with the NSE bot above) ───
# Same bot as the MT5 feed VM. All CFD consumer alerts go here only.
MT5_TELEGRAM_BOT_TOKEN=8522382590:AAHadfq6CFDDue4L_ELyYixr58Nvn9tewsw
MT5_TELEGRAM_CHAT_ID=1655289022

